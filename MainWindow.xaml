<Window x:Class="KeyboardPadBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:KeyboardPadBridge.Models"
        mc:Ignorable="d"
        Title="KeyBridge"
        Width="1180"
        Height="640"
        MinWidth="760"
        MinHeight="500"
        Background="{DynamicResource CanvasParchmentBrush}"
        Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CanvasParchmentBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="SurfacePearlBrush" Color="#FAFAFC" />
        <SolidColorBrush x:Key="SurfaceDarkBrush" Color="#272729" />
        <SolidColorBrush x:Key="InkBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="MutedDarkBrush" Color="#CCCCCC" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0066CC" />
        <SolidColorBrush x:Key="PrimaryOnDarkBrush" Color="#2997FF" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="DividerSoftBrush" Color="#F0F0F0" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Malgun Gothic, Segoe UI, system-ui" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="NavText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="HeroTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="38" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="DisplayTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="32" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="LeadText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfacePearlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Malgun Gothic, Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfacePearlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Malgun Gothic, Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceDarkBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource SurfaceDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="16,5" />
        </Style>

        <Style x:Key="SecondaryPillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="14,4" />
        </Style>

        <Style x:Key="UtilityCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfacePearlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,4">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            MinWidth="180"
                            Margin="0,0,12,0">
                    <TextBlock Text="KeyBridge"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="PC 키보드 브릿지"
                               Style="{StaticResource NavText}" />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="30">
                    <Button Content="클립보드 공유"
                            MinWidth="112"
                            Margin="0,0,6,0"
                            Click="ShareClipboardButton_Click" />
                    <Button Content="클립보드 입력"
                            MinWidth="112"
                            Margin="0,0,6,0"
                            Click="TypeClipboardButton_Click" />
                    <Button x:Name="BridgeToggleButton"
                            Content="연결"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0"
                            Click="BridgeToggleButton_Click" />
                    <ToggleButton x:Name="AdvancedMenuButton"
                                  Content="고급"
                                  MinHeight="28"
                                  MinWidth="72"
                                  Padding="12,4"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                    <Popup PlacementTarget="{Binding ElementName=AdvancedMenuButton}"
                           Placement="Bottom"
                           IsOpen="{Binding IsChecked, ElementName=AdvancedMenuButton}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           HorizontalOffset="-236"
                           PopupAnimation="Fade">
                        <Border Background="{StaticResource CanvasBrush}"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10"
                                Margin="0,6,0,0"
                                Width="308">
                            <StackPanel>
                                <TextBlock Text="고급 도구"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Margin="0,0,0,8" />
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <CheckBox x:Name="SuppressKeysCheckBox"
                                              Content="키 입력 차단"
                                              IsChecked="True"
                                              Margin="0,0,8,6"
                                              VerticalAlignment="Center"
                                              Checked="SuppressKeysCheckBox_Changed"
                                              Unchecked="SuppressKeysCheckBox_Changed" />
                                    <CheckBox x:Name="MouseSignalCheckBox"
                                              Content="마우스 신호"
                                              IsChecked="False"
                                              Margin="0,0,0,6"
                                              VerticalAlignment="Center"
                                              Checked="MouseSignalCheckBox_Changed"
                                              Unchecked="MouseSignalCheckBox_Changed" />
                                    <CheckBox x:Name="StartWithWindowsCheckBox"
                                              Content="시작 시 실행"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Checked="StartWithWindowsCheckBox_Changed"
                                              Unchecked="StartWithWindowsCheckBox_Changed" />
                                    <CheckBox x:Name="AutoClipboardShareCheckBox"
                                              Content="자동 공유"
                                              IsChecked="True"
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              Checked="AutoClipboardShareCheckBox_Changed"
                                              Unchecked="AutoClipboardShareCheckBox_Changed" />
                                </UniformGrid>
                                <Separator Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                <Button Content="Screenshot"
                                        MinWidth="0"
                                        Margin="0,0,6,6"
                                        Click="ScreenshotButton_Click" />
                                <Button Content="이미지 공유"
                                        MinWidth="0"
                                        Margin="0,0,0,6"
                                        Click="ShareClipboardImageButton_Click" />
                                <Button x:Name="MouseTestButton"
                                        Content="마우스 테스트"
                                        MinWidth="0"
                                        Margin="0,0,6,6"
                                        Click="MouseTestButton_Click" />
                                <Button x:Name="ProbeButton"
                                        Content="진단"
                                        MinWidth="0"
                                        Margin="0,0,0,6"
                                        Click="ProbeButton_Click" />
                                </UniformGrid>
                                <Button x:Name="ResetIpadPairingButton"
                                        Content="iPad 페어링 초기화"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,2,0,6"
                                        Click="ResetIpadPairingButton_Click" />
                                <Button Content="iPad 복구 안내"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        Click="ShowIpadRecoveryGuideButton_Click" />
                                <Button x:Name="AdvertiseButton"
                                        Content="기기 다시 찾기"
                                        Style="{StaticResource SecondaryPillButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"
                                        Click="AdvertiseButton_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{StaticResource CanvasBrush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid MaxWidth="1160"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="KeyBridge"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="노트북 입력을 iPad로 빠르게 전환합니다."
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0">
                            <Border Background="{StaticResource SurfacePearlBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10,4"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Alt + Q"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="연결 / 해제"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                        </WrapPanel>
                    </Grid>
                </Border>
                <Border Background="{StaticResource CanvasBrush}"
                        Padding="18,18,18,16"
                        Visibility="Collapsed">
                    <StackPanel MaxWidth="980"
                                HorizontalAlignment="Center">
                        <TextBlock Text="노트북 키보드를 iPad까지."
                                   Style="{StaticResource HeroTitle}" />
                        <TextBlock Text="KeyBridge는 Windows 노트북 입력을 Bluetooth 키보드와 마우스처럼 다른 기기에 이어주는 조용한 생산성 도구입니다."
                                   Style="{StaticResource LeadText}"
                                   Margin="0,6,0,12"
                                   MaxWidth="760" />
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="연결 / 해제"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,10,8"
                                    Click="BridgeToggleButton_Click" />
                            <Button Content="기기 다시 찾기"
                                    Style="{StaticResource SecondaryPillButton}"
                                    Margin="0,0,0,8"
                                    Click="AdvertiseButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CanvasParchmentBrush}"
                        Padding="10,6">
                    <WrapPanel MaxWidth="1160"
                               HorizontalAlignment="Center"
                               ItemWidth="432">
                        <Border Style="{StaticResource UtilityCard}"
                                Width="416"
                                MinHeight="262"
                                Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="현재 상태"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="ActiveDeviceNameText"
                                           Text="노트북 -> iPad"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           LineHeight="29"
                                           Margin="0,4,0,0" />
                                <TextBlock x:Name="StatusText"
                                           Text="연결 준비 완료"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           LineHeight="22"
                                           Margin="0,1,0,6" />

                                <Viewbox Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         HorizontalAlignment="Center"
                                         MaxWidth="244"
                                         Margin="0,0,0,4">
                                    <Grid Width="620" Height="154">
                                        <Grid Width="230"
                                              Height="112"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="20,0,0,0">
                                            <Grid Margin="22,6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="16" />
                                                </Grid.RowDefinitions>

                                                <Canvas Grid.Row="0"
                                                        Width="150"
                                                        Height="82"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom">
                                                    <Border Width="132"
                                                            Height="70"
                                                            Canvas.Left="9"
                                                            Canvas.Top="0"
                                                            CornerRadius="7"
                                                            BorderBrush="#D2D2D7"
                                                            BorderThickness="2"
                                                            Background="{StaticResource SurfacePearlBrush}" />
                                                    <Line X1="16" Y1="88" X2="144" Y2="88"
                                                          Stroke="#C9C9CF"
                                                          StrokeThickness="2" />
                                                    <Path Fill="#D8D8DE"
                                                          Data="M 0,78 L 150,78 L 138,82 L 12,82 Z" />
                                                    <Path Fill="#C9C9CF"
                                                          Data="M 68,92 L 92,92 L 88,95 L 72,95 Z" />
                                                </Canvas>

                                                <TextBlock Text="노트북"
                                                           Grid.Row="1"
                                                           FontSize="13"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="0,2,0,0" />
                                            </Grid>
                                        </Grid>

                                        <Canvas Width="150"
                                                Height="56"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Line X1="0" Y1="28" X2="128" Y2="28"
                                                  Stroke="{StaticResource PrimaryBrush}"
                                                  StrokeThickness="3" />
                                            <Polygon Points="128,18 150,28 128,38"
                                                     Fill="{StaticResource PrimaryBrush}" />
                                            <Ellipse Width="6" Height="6" Fill="#A6CBEF" Canvas.Left="54" Canvas.Top="43" />
                                            <Ellipse Width="6" Height="6" Fill="#6BA9E8" Canvas.Left="73" Canvas.Top="43" />
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryBrush}" Canvas.Left="92" Canvas.Top="43" />
                                        </Canvas>

                                        <Border Width="150"
                                                Height="164"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                CornerRadius="24"
                                                BorderBrush="#D2D2D7"
                                                BorderThickness="2"
                                                Background="{StaticResource CanvasBrush}"
                                                Margin="0,0,20,0">
                                            <Border Margin="16"
                                                    CornerRadius="16"
                                                    Background="{StaticResource SurfacePearlBrush}">
                                                <TextBlock Text="iPad"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Viewbox>

                                <WrapPanel HorizontalAlignment="Center">
                                    <Border Style="{StaticResource StatusCard}" Width="88" Margin="0,0,5,4">
                                        <StackPanel>
                                            <TextBlock Text="키보드" Style="{StaticResource CaptionText}" />
                                            <TextBlock x:Name="KeyboardStateText" Text="준비됨" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatusCard}" Width="96" Margin="0,0,5,4">
                                        <StackPanel>
                                            <TextBlock Text="블루투스" Style="{StaticResource CaptionText}" />
                                            <TextBlock x:Name="BackendStateText" Text="BLE HID" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatusCard}" Width="88" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="마우스" Style="{StaticResource CaptionText}" />
                                            <TextBlock x:Name="MouseStateText" Text="준비됨" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Width="416">
                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="빠른 동작"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="불필요한 화면 전환 없이 빠르게 연결하고 해제합니다."
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,1,0,4" />
                                    <Button Content="연결 / 해제"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Click="BridgeToggleButton_Click" />
                                    <Button Content="클립보드 입력"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,3,0,0"
                                            Click="TypeClipboardButton_Click" />
                                    <Button Content="클립보드 공유"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,3,0,0"
                                            Click="ShareClipboardButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="iPad 클립보드 주소"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="PC와 iPad가 같은 Wi-Fi나 핫스팟에 있을 때 브라우저에서 여세요. HTTPS는 로컬 인증서 경고가 뜰 수 있습니다."
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,1,0,3" />
                                    <TextBox x:Name="ClipboardUrlTextBox"
                                             IsReadOnly="True"
                                             MinHeight="24"
                                             VerticalContentAlignment="Center"
                                             Text="서버 준비 중" />
                                    <TextBlock Text="PIN"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,4,0,1" />
                                    <TextBox x:Name="ClipboardPinTextBox"
                                             MinHeight="24"
                                             VerticalContentAlignment="Center" />
                                    <CheckBox x:Name="FixedClipboardPinCheckBox"
                                              Content="PIN 고정"
                                              IsChecked="True"
                                              Margin="0,3,0,2" />
                                    <UniformGrid Columns="5" Margin="0,4,0,0">
                                        <Button Content="주소 복사"
                                                MinWidth="0"
                                                Padding="7,4"
                                                Margin="0,0,6,0"
                                                Click="CopyClipboardUrlButton_Click" />
                                        <Button Content="주소 새로고침"
                                                MinWidth="0"
                                                Padding="7,4"
                                                Margin="0,0,6,0"
                                                Click="RefreshClipboardUrlButton_Click" />
                                        <Button Content="PIN 적용"
                                                MinWidth="0"
                                                Padding="7,4"
                                                Margin="0,0,6,0"
                                                Click="ApplyClipboardPinButton_Click" />
                                        <Button Content="PIN 복사"
                                                MinWidth="0"
                                                Padding="7,4"
                                                Margin="0,0,6,0"
                                                Click="CopyClipboardPinButton_Click" />
                                        <Button Content="새 주소"
                                                MinWidth="0"
                                                Padding="7,4"
                                                Margin="0"
                                                Click="RegenerateClipboardSecurityButton_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Expander Header="고급 도구" Margin="0,0,0,8">
                                <StackPanel Margin="0,6,0,0">
                                    <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="페어링"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="RemoteDeviceText"
                                                       Text="iPad에서 '액세서리'를 찾아 연결하세요. 연결 후에는 이 PC의 블루투스 이름으로 바뀔 수 있습니다."
                                                       Style="{StaticResource CaptionText}"
                                                       Margin="0,2,0,10" />
                                            <Button Content="기기 다시 찾기"
                                                    Style="{StaticResource SecondaryPillButton}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="AdvertiseButton_Click" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource UtilityCard}"
                                            Background="{StaticResource SurfaceDarkBrush}">
                                        <StackPanel>
                                            <TextBlock Text="트레이 미니"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="KeyBridge가 조용히 실행 중일 때 빠르게 상태를 확인하는 작은 화면입니다."
                                                       Foreground="{StaticResource MutedDarkBrush}"
                                                       FontSize="14"
                                                       LineHeight="21"
                                                       Margin="0,2,0,10" />
                                            <Border Background="#1D1D1F"
                                                    BorderBrush="#3A3A3C"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="KeyBridge"
                                                                   Foreground="{StaticResource MutedDarkBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="연결 준비 완료"
                                                                   Foreground="White"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="열기"
                                                            MinWidth="78"
                                                            Padding="18,8" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Border Background="{StaticResource CanvasBrush}"
                        Padding="14,4">
                        <StackPanel MaxWidth="1160"
                                    HorizontalAlignment="Center">
                        <StackPanel MaxWidth="760"
                                    Margin="0">
                            <TextBlock Text="설정"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Visibility="Collapsed" />
                            <TextBlock Text="Windows 키보드 감각을 최대한 유지하면서 iPad에 자연스럽게 전달되도록 조정합니다."
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,3,0,0"
                                       Visibility="Collapsed" />
                            <Expander Header="고급 설정" Margin="0">
                                <StackPanel>
                            <Border Background="{StaticResource CanvasParchmentBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="단축키"
                                               FontWeight="SemiBold"
                                               FontSize="16" />
                                    <TextBlock Text="Alt + Q: 브릿지 시작 / 중지"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="Ctrl + F8: 마우스 신호 켜기 / 끄기"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="Ctrl + Alt + E: 이모티콘 / 입력 선택"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="Ctrl + Alt + Esc: 긴급 중지"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="F3: 클립보드 텍스트 입력"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="Ctrl + Shift + V: 스마트 입력으로 클립보드 텍스트 입력"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="F4 / Ctrl + Alt + I: 이미지 공유"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="F5: iPad 현재 창 새로고침"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="Ctrl + Alt + S: 스크린샷 공유"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="Esc: 클립보드 입력 취소"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="Ctrl + Shift + Esc: 로컬 작업 관리자 열기"
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>

                        <WrapPanel>
                            <Border Style="{StaticResource UtilityCard}" Width="324" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="노트북 입력"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <CheckBox x:Name="SuppressKeysCheckBoxSettings"
                                              Content="브릿지 중 노트북 키 입력 차단"
                                              IsChecked="{Binding IsChecked, ElementName=SuppressKeysCheckBox}"
                                              Margin="0,7,0,4" />
                                    <TextBlock Text="iPad로 입력을 보내는 동안 노트북에도 중복 입력되지 않도록 막습니다."
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Width="324" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="마우스"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <CheckBox x:Name="MouseSignalCheckBoxSettings"
                                              Content="마우스 신호 보내기"
                                              IsChecked="{Binding IsChecked, ElementName=MouseSignalCheckBox}"
                                              Margin="0,7,0,4" />
                                    <TextBlock x:Name="MouseSignalSummaryText"
                                               Text="켜짐"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="마우스 이동, 클릭, 휠 입력을 iPad 포인터로 전달합니다."
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Width="324" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="시작"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <CheckBox x:Name="StartWithWindowsCheckBoxSettings"
                                              Content="Windows 시작 시 자동 실행"
                                              IsChecked="{Binding IsChecked, ElementName=StartWithWindowsCheckBox}"
                                              Margin="0,7,0,4" />
                                    <TextBlock Text="Windows가 시작될 때 KeyBridge를 조용히 실행합니다. 필요할 때 트레이에서 다시 열 수 있습니다."
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Width="324" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="클립보드 공유"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <CheckBox x:Name="AutoClipboardShareCheckBoxSettings"
                                              Content="클립보드 변경 시 자동 공유"
                                              IsChecked="{Binding IsChecked, ElementName=AutoClipboardShareCheckBox}"
                                              Margin="0,7,0,4" />
                                    <CheckBox x:Name="ClipboardCodeLanguageCheckBox"
                                              Content="코드블록 시작 표시줄에 언어명 붙이기"
                                              Margin="0,3,0,4"
                                              Checked="ClipboardCodeLanguageCheckBox_Changed"
                                              Unchecked="ClipboardCodeLanguageCheckBox_Changed" />
                                    <CheckBox x:Name="ClipboardBracketMarkerCheckBox"
                                              Content="코드블록 표식을 &lt;&lt;&lt;] / [&gt;&gt;&gt; 로 쓰기"
                                              Margin="0,3,0,4"
                                              Checked="ClipboardBracketMarkerCheckBox_Changed"
                                              Unchecked="ClipboardBracketMarkerCheckBox_Changed" />
                                    <TextBlock Text="텍스트, 이미지, 파일을 iPad의 /clipboard 페이지로 자동 갱신합니다."
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Width="658" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Google Docs 최신 텍스트"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <CheckBox x:Name="GoogleDocsSyncCheckBox"
                                              Content="텍스트 클립보드를 지정 문서에 덮어쓰기"
                                              Margin="0,7,0,6"
                                              Checked="GoogleDocsSyncCheckBox_Changed"
                                              Unchecked="GoogleDocsSyncCheckBox_Changed" />
                                    <TextBlock Text="Google OAuth Desktop client JSON"
                                               Style="{StaticResource CaptionText}" />
                                    <DockPanel Margin="0,4,0,8">
                                        <Button Content="찾기"
                                                DockPanel.Dock="Right"
                                                MinWidth="86"
                                                Margin="8,0,0,0"
                                                Click="BrowseGoogleClientSecretsButton_Click" />
                                        <TextBox x:Name="GoogleClientSecretsPathTextBox"
                                                 MinHeight="30"
                                                 VerticalContentAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="Google Docs 문서 URL 또는 ID"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBox x:Name="GoogleDocsDocumentTextBox"
                                             MinHeight="32"
                                             Margin="0,4,0,8"
                                             VerticalContentAlignment="Center" />
                                    <WrapPanel>
                                        <Button Content="설정 저장"
                                                MinWidth="108"
                                                Margin="0,0,8,8"
                                                Click="SaveGoogleDocsSettingsButton_Click" />
                                        <Button x:Name="TestGoogleDocsButton"
                                                Content="로그인 / 연결 확인"
                                                MinWidth="162"
                                                Margin="0,0,8,8"
                                                Click="TestGoogleDocsButton_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="GoogleDocsStatusText"
                                               Text="동기화 꺼짐"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,6" />
                                    <TextBlock Text="문서는 최신 텍스트 하나만 유지합니다. 이미지와 파일은 기존 /clipboard 페이지로 공유합니다."
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Width="324" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="진단"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Bluetooth HID 상태를 확인하고 페어링 광고를 다시 시작합니다."
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,4,0,8" />
                                    <WrapPanel>
                                        <Button Content="진단 실행"
                                                MinWidth="116"
                                                Margin="0,0,6,6"
                                                Click="ProbeButton_Click" />
                                        <Button Content="기기 다시 찾기"
                                                Style="{StaticResource SecondaryPillButton}"
                                                MinWidth="126"
                                                Margin="0,0,0,6"
                                                Click="AdvertiseButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CanvasParchmentBrush}"
                        Padding="10,4,10,8">
                    <Border Style="{StaticResource UtilityCard}"
                            MaxWidth="1160"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="150" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0"
                                       LastChildFill="True"
                                       Margin="0,0,0,4">
                                <WrapPanel DockPanel.Dock="Right"
                                           Margin="12,0,0,2">
                                    <Button Content="로그 복사"
                                            MinWidth="84"
                                            Padding="10,4"
                                            Margin="0,0,5,2"
                                            Click="CopyLogsButton_Click" />
                                    <Button Content="로그 지우기"
                                            MinWidth="88"
                                            Padding="10,4"
                                            Margin="0,0,0,2"
                                            Click="ClearLogButton_Click" />
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="입력 로그"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="동작 기록은 보이되, 브릿지 사용을 방해하지 않게 정리했습니다."
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,1,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </DockPanel>

                            <ListBox Grid.Row="1"
                                     x:Name="ActivityListBox"
                                     ItemsSource="{Binding ActivityEvents}"
                                     BorderBrush="{StaticResource HairlineBrush}"
                                     BorderThickness="1"
                                     Background="{StaticResource CanvasBrush}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ActivityEvent}">
                                        <Grid Margin="5,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Channel}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Message}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
