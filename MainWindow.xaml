<Window x:Class="KeyboardPadBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:KeyboardPadBridge.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="KeyBridge"
        Width="1180"
        Height="780"
        MinWidth="760"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="InkBrush" Color="#111827" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="FaintBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE3EA" />
        <SolidColorBrush x:Key="SoftLineBrush" Color="#E8EDF3" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF3" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Malgun Gothic, Segoe UI" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Malgun Gothic, Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SubtlePanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="22,9" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Background" Value="{StaticResource SubtlePanelBrush}" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SubtlePanelBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SoftLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B91C1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="InsetPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SubtlePanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource InsetPanel}">
            <Setter Property="MinHeight" Value="74" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Malgun Gothic, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="22"
                           Height="22"
                           Source="Assets/keybridge.ico"
                           Margin="0,0,10,0" />
                    <TextBlock Text="KeyBridge"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource PrimarySoftBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,3"
                            Margin="12,0,0,0">
                        <TextBlock Text="Bluetooth HID"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="PC keyboard and pointer bridge"
                           Style="{StaticResource CaptionText}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}"
                            ToolTip="최소화"
                            Click="MinimizeTitleButton_Click">
                        <Rectangle Width="10"
                                   Height="1.4"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   RadiusX="0.7"
                                   RadiusY="0.7" />
                    </Button>
                    <Button x:Name="MaximizeTitleButton"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="최대화"
                            Click="MaximizeTitleButton_Click">
                        <Grid Width="12"
                              Height="12">
                            <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.4"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Fill="Transparent" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseTitleBarButton}"
                            ToolTip="닫기"
                            Click="CloseTitleButton_Click">
                        <Grid Width="12"
                              Height="12">
                            <Line X1="2"
                                  Y1="2"
                                  X2="10"
                                  Y2="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Line X1="10"
                                  Y1="2"
                                  X2="2"
                                  Y2="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            Background="{StaticResource PrimarySoftBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="7"
                            Margin="0,0,10,0">
                        <TextBlock Text="K"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="KeyBridge"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="PC 입력을 iPad로 전달"
                                   Style="{StaticResource CaptionText}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource SuccessSoftBrush}"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="9,5"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusText"
                                       Text="연결 준비됨"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ActiveDeviceNameText"
                               Text="PC -> iPad"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <WrapPanel Grid.Column="2"
                           VerticalAlignment="Center"
                           ItemHeight="28">
                    <CheckBox x:Name="SuppressKeysCheckBox"
                              Content="로컬 입력 차단"
                              IsChecked="True"
                              Margin="0,0,14,0"
                              Checked="SuppressKeysCheckBox_Changed"
                              Unchecked="SuppressKeysCheckBox_Changed" />
                    <CheckBox x:Name="MouseSignalCheckBox"
                              Content="마우스"
                              IsChecked="False"
                              Margin="0,0,14,0"
                              Checked="MouseSignalCheckBox_Changed"
                              Unchecked="MouseSignalCheckBox_Changed" />
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Content="시작 시 실행"
                              Margin="0,0,0,0"
                              Checked="StartWithWindowsCheckBox_Changed"
                              Unchecked="StartWithWindowsCheckBox_Changed" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource Panel}"
                    Padding="30"
                    Margin="0,0,18,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="상태"
                                       Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="PC에서 iPad까지"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       LineHeight="38"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button x:Name="AdvertiseButton"
                                    Content="기기 다시 찾기"
                                    Style="{StaticResource QuietButton}"
                                    Margin="0,0,8,0"
                                    Click="AdvertiseButton_Click" />
                            <Button x:Name="BridgeToggleButton"
                                    Content="연결"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BridgeToggleButton_Click" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1"
                          MaxWidth="650"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="156"
                                Height="112"
                                CornerRadius="8"
                                Background="{StaticResource SubtlePanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="PC"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Keyboard + Mouse"
                                           Style="{StaticResource CaptionText}"
                                           FontSize="12"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Height="28">
                                <Line X1="0"
                                      Y1="14"
                                      X2="150"
                                      Y2="14"
                                      Stroke="{StaticResource PrimaryBrush}"
                                      StrokeThickness="2"
                                      HorizontalAlignment="Center" />
                                <Path Fill="{StaticResource PrimaryBrush}"
                                      Data="M 0,0 L 16,8 L 0,16 Z"
                                      HorizontalAlignment="Right"
                                      Margin="0,6,14,0" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="Bluetooth HID"
                                       Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </Grid>

                        <Border Grid.Column="2"
                                Width="118"
                                Height="146"
                                CornerRadius="8"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <Border Margin="11"
                                    CornerRadius="6"
                                    Background="{StaticResource SubtlePanelBrush}">
                                <TextBlock Text="iPad"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </Grid>

                    <UniformGrid Grid.Row="2"
                                 Columns="3"
                                 Margin="0,8,0,0">
                        <Border Style="{StaticResource StatusChip}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="키보드"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="KeyboardStateText"
                                           Text="준비됨"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusChip}"
                                Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="블루투스"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="BackendStateText"
                                           Text="BLE HID"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusChip}"
                                Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="마우스"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="MouseStateText"
                                           Text="준비됨"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,18">
                <Border Style="{StaticResource Panel}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="빠른 동작"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="연결 중에도 필요한 작업만 바로 실행합니다."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,14" />
                        <Button Content="클립보드 입력"
                                HorizontalAlignment="Stretch"
                                Click="TypeClipboardButton_Click" />
                        <Button x:Name="MouseTestButton"
                                Content="마우스 테스트"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Click="MouseTestButton_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="입력 설정"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="브릿지 동작 중 로컬 입력과 포인터 전달 방식을 조정합니다."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,14" />
                        <CheckBox x:Name="SuppressKeysCheckBoxSettings"
                                  Content="브릿지 중 노트북 키 입력 차단"
                                  IsChecked="{Binding IsChecked, ElementName=SuppressKeysCheckBox}"
                                  Margin="0,0,0,10" />
                        <CheckBox x:Name="MouseSignalCheckBoxSettings"
                                  Content="마우스 신호 보내기"
                                  IsChecked="{Binding IsChecked, ElementName=MouseSignalCheckBox}"
                                  Margin="0,0,0,8" />
                        <TextBlock x:Name="MouseSignalSummaryText"
                                   Text="켜짐"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="진단"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="RemoteDeviceText"
                                   Text="iPad에서 액세서리를 찾아 연결하세요. 연결 후에는 PC의 블루투스 이름으로 표시될 수 있습니다."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,14" />
                        <WrapPanel>
                            <Button x:Name="ProbeButton"
                                    Content="진단 실행"
                                    Margin="0,0,8,8"
                                    Click="ProbeButton_Click" />
                            <Button Content="기기 다시 찾기"
                                    Style="{StaticResource QuietButton}"
                                    Margin="0,0,0,8"
                                    Click="AdvertiseButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource Panel}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="18,0">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right"
                                    VerticalAlignment="Center">
                            <Button Content="로그 복사"
                                    Style="{StaticResource QuietButton}"
                                    MinWidth="82"
                                    Margin="0,0,8,0"
                                    Click="CopyLogsButton_Click" />
                            <Button Content="로그 지우기"
                                    Style="{StaticResource QuietButton}"
                                    MinWidth="88"
                                    Click="ClearLogButton_Click" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="최근 활동"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="입력, 진단, 연결 상태를 최신순으로 표시합니다."
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             x:Name="ActivityListBox"
                             ItemsSource="{Binding ActivityEvents}"
                             BorderBrush="{StaticResource SoftLineBrush}"
                             BorderThickness="0,1,0,0"
                             Background="{StaticResource PanelBrush}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ActivityEvent}">
                                <Grid Margin="16,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Channel}"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
