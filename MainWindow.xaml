<Window x:Class="KeyboardPadBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:KeyboardPadBridge.Models"
        mc:Ignorable="d"
        Title="KeyBridge"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        Background="#F4F1EA"
        Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#1D2522" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65706B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF4" />
        <SolidColorBrush x:Key="LineBrush" Color="#D8D0C2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6A5B" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF1EA" />
        <SolidColorBrush x:Key="WarnBrush" Color="#B45525" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SuppressKeysCheckBox"
                          Content="Block local keystrokes"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="SuppressKeysCheckBox_Changed"
                          Unchecked="SuppressKeysCheckBox_Changed" />
                <CheckBox x:Name="MouseSignalCheckBox"
                          Content="Mouse signal"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="MouseSignalCheckBox_Changed"
                          Unchecked="MouseSignalCheckBox_Changed" />
                <Button x:Name="MouseTestButton"
                        Content="마우스 테스트"
                        Margin="0,0,8,0"
                        Click="MouseTestButton_Click" />
                <Button x:Name="ProbeButton"
                        Content="Run Probe"
                        Margin="0,0,8,0"
                        Click="ProbeButton_Click" />
                <Button x:Name="AdvertiseButton"
                        Content="기기 다시 찾기"
                        Margin="0,0,8,0"
                        Click="AdvertiseButton_Click" />
                <Button x:Name="BridgeToggleButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Start Bridge"
                        Click="BridgeToggleButton_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="KeyBridge"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="PC keyboard bridge for iPad and tablet input"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="18" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="BLE HID Session"
                               FontSize="18"
                               FontWeight="SemiBold" />
                            <TextBlock Text="On iPad, KeyBridge may first appear as Accessory. After pairing, it may change to this PC's Bluetooth device name."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,18" />

                    <Border Padding="14"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Advertised Role"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="BLE HID Keyboard + Mouse"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="Remote Device"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock x:Name="RemoteDeviceText"
                                       Text="Waiting for iPad/phone pairing"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="Emergency Stop"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="Ctrl+` toggles, Ctrl+Alt+Esc stops"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="Local Safety"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="Use Windows-style Ctrl shortcuts"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="Mouse"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock x:Name="MouseSignalSummaryText"
                                       Text="Off"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="Shortcuts"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+`" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Start / stop bridge" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+1" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Mouse signal on / off" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Alt+Esc" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Emergency stop" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Alt+Tab" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Switch apps on iPad" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+A/C/V" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Windows-style shortcuts" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Han/Eng" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Input language switch" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="20" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="ActiveDeviceNameText"
                                       Text="BLE HID Keyboard + Mouse"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText"
                                       Text="Idle"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Center">
                            <StackPanel Margin="18,0,0,0">
                                <TextBlock Text="Keyboard" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="KeyboardStateText" Text="Ready" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="18,0,0,0">
                                <TextBlock Text="Pointer" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="MouseStateText" Text="Ready" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="18,0,0,0">
                                <TextBlock Text="Backend" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="BackendStateText" Text="BLE HID" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button Content="Copy Logs"
                                        Margin="0,0,8,0"
                                        Click="CopyLogsButton_Click" />
                                <Button Content="Clear Log"
                                        Click="ClearLogButton_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Input Events"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Start the bridge, then use any app. Ctrl+Alt+Esc stops capture immediately."
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 x:Name="ActivityListBox"
                                 ItemsSource="{Binding ActivityEvents}"
                                 BorderBrush="{StaticResource LineBrush}"
                                 Background="#FFFFFF">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ActivityEvent}">
                                    <Grid Margin="10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Channel}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFF7E8"
                BorderBrush="#E8CA96"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,18,0,0">
            <TextBlock Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap"
                       Text="Prototype status: BLE HID keyboard/mouse, global input capture, Windows-style shortcut translation, and mouse-signal gating are implemented. Ctrl+` starts/stops KeyBridge; Ctrl+Alt+Esc is backup stop." />
        </Border>
    </Grid>
</Window>
