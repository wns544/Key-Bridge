<Window x:Class="KeyboardPadBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:KeyboardPadBridge.Models"
        mc:Ignorable="d"
        Title="KeyBridge"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        Background="#F4F1EA"
        Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#1D2522" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65706B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF4" />
        <SolidColorBrush x:Key="LineBrush" Color="#D8D0C2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6A5B" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF1EA" />
        <SolidColorBrush x:Key="WarnBrush" Color="#B45525" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Malgun Gothic, Segoe UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SuppressKeysCheckBox"
                          Content="노트북 입력 차단"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="SuppressKeysCheckBox_Changed"
                          Unchecked="SuppressKeysCheckBox_Changed" />
                <CheckBox x:Name="MouseSignalCheckBox"
                          Content="마우스 전송"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="MouseSignalCheckBox_Changed"
                          Unchecked="MouseSignalCheckBox_Changed" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="윈도우 시작 시 실행"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="StartWithWindowsCheckBox_Changed"
                          Unchecked="StartWithWindowsCheckBox_Changed" />
                <Button x:Name="TypeClipboardButton"
                        Content="클립보드 입력"
                        Margin="0,0,8,0"
                        Click="TypeClipboardButton_Click" />
                <Button x:Name="MouseTestButton"
                        Content="마우스 테스트"
                        Margin="0,0,8,0"
                        Click="MouseTestButton_Click" />
                <Button x:Name="ProbeButton"
                        Content="진단 실행"
                        Margin="0,0,8,0"
                        Click="ProbeButton_Click" />
                <Button x:Name="AdvertiseButton"
                        Content="기기 다시 찾기"
                        Margin="0,0,8,0"
                        Click="AdvertiseButton_Click" />
                <Button x:Name="BridgeToggleButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="브릿지 시작"
                        Click="BridgeToggleButton_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="KeyBridge"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="노트북 키보드와 마우스를 iPad로 보내는 브릿지"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="18" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="블루투스 HID 세션"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="iPad에서는 처음에 '액세서리'로 보일 수 있고, 연결 후 이 PC의 블루투스 이름으로 바뀔 수 있습니다."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,18" />

                    <Border Padding="14"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="전송 역할"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="BLE HID 키보드 + 마우스"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="연결 대상"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock x:Name="RemoteDeviceText"
                                       Text="iPad/휴대폰 연결 대기 중"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="긴급 중지"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="Ctrl+CapsLock: 시작/중지, Ctrl+Alt+Esc: 긴급 중지"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="로컬 안전"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="윈도우식 Ctrl 단축키 사용"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="마우스"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock x:Name="MouseSignalSummaryText"
                                       Text="꺼짐"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="단축키"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Caps" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="브릿지 시작/중지" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+F8" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="마우스 전송 켜기/끄기" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Alt+Esc" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="긴급 중지" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Alt+Tab" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="iPad 앱 전환" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+A/C/V" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="윈도우식 단축키" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="한/영" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="입력 언어 전환" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="20" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="ActiveDeviceNameText"
                                       Text="BLE HID 키보드 + 마우스"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText"
                                       Text="대기 중"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Center">
                            <StackPanel Margin="18,0,0,0">
                                <TextBlock Text="키보드" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="KeyboardStateText" Text="준비됨" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="18,0,0,0">
                                <TextBlock Text="마우스" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="MouseStateText" Text="준비됨" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="18,0,0,0">
                                <TextBlock Text="백엔드" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="BackendStateText" Text="BLE HID" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button Content="로그 복사"
                                        Margin="0,0,8,0"
                                        Click="CopyLogsButton_Click" />
                                <Button Content="로그 지우기"
                                        Click="ClearLogButton_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="입력 로그"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="브릿지를 시작한 뒤 iPad에서 입력할 앱을 열어 사용하세요. Ctrl+Alt+Esc는 즉시 중지합니다."
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 x:Name="ActivityListBox"
                                 ItemsSource="{Binding ActivityEvents}"
                                 BorderBrush="{StaticResource LineBrush}"
                                 Background="#FFFFFF">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ActivityEvent}">
                                    <Grid Margin="10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Channel}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFF7E8"
                BorderBrush="#E8CA96"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,18,0,0">
            <TextBlock Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap"
                       Text="현재 상태: BLE HID 키보드/마우스, 전역 입력 캡처, 윈도우식 단축키 변환, 마우스 전송 제어가 구현되어 있습니다. Ctrl+CapsLock으로 시작/중지하고, Ctrl+Alt+Esc로 긴급 중지합니다." />
        </Border>
    </Grid>
</Window>
