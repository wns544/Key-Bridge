<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KeyBridge</AssemblyName>
    <Product>KeyBridge</Product>
    <ApplicationIcon>Assets\keybridge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <None Remove="tools\**\*" />
    <None Remove="Assets\keybridge.ico" />
    <Content Include="Assets\keybridge.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Docs.v1" Version="1.74.0.4134" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.74.0.4135" />
  </ItemGroup>

</Project>
